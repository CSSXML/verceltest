# Supabase PostgreSQL connection used by server-side code only.
POSTGRES_URL=

# Server-side signing secrets. Never prefix these with NEXT_PUBLIC_.
JWT_SECRET=
CAPTCHA_SECRET=

# Supabase Storage (server-side only; used by /api/photos)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Only add NEXT_PUBLIC_ variables when the value is safe to expose publicly.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
